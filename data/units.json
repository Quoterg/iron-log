{
  "_comment": "Approximate household measures for common foods, matched against Livsmedelsverket names (first matching rule wins). Units: st = piece, dl, msk = tablespoon (15 ml), tsk = teaspoon (5 ml), skiva = slice, glas = glass (2 dl), kopp = cup (1.5 dl), portion, smörgås = spread on one sandwich. Grams are edible weight. Sources: typical Swedish household weights (Livsmedelsverket 'Vikttabell' style); values are approximate and shown as ≈ in the app.",
  "rules": [
    { "match": "^Ägg (kokt|stekt|rått|förlorat|poscherat)", "units": [["st", 55]] },
    { "match": "^Äggula", "units": [["st", 18]] },
    { "match": "^Äggvita", "units": [["st", 35]] },
    { "match": "^Banan$", "units": [["st", 120]] },
    { "match": "^Äpple (m\\. skal|u\\. skal|Aroma|Ingrid|Granny|Royal|Pink|röd|grön)", "units": [["st", 150]] },
    { "match": "^Päron( m\\. skal| u\\. skal)?$", "units": [["st", 160]] },
    { "match": "^Apelsin$", "units": [["st", 140]] },
    { "match": "^(Clementin|Mandarin)", "units": [["st", 60]] },
    { "match": "^Kiwi", "units": [["st", 75]] },
    { "match": "^Avokado$", "units": [["st", 140]] },
    { "match": "^Tomat$", "units": [["st", 100]] },
    { "match": "^(Körsbärstomat|Tomat körsbär)", "units": [["st", 15]] },
    { "match": "^Gurka$", "units": [["st", 350], ["skiva", 5]] },
    { "match": "^Morot$", "units": [["st", 70]] },
    { "match": "^Lök gul$", "units": [["st", 100]] },
    { "match": "^Vitlök", "units": [["st", 4]] },
    { "match": "^Paprika (röd|grön|gul)$", "units": [["st", 150]] },
    { "match": "^Potatis .*kokt", "units": [["st", 70]] },
    { "match": "^Jordgubbar$", "units": [["st", 15], ["dl", 65]] },
    { "match": "^(Blåbär|Hallon|Lingon)( frysvara)?$", "units": [["dl", 60]] },
    { "match": "^Vindruvor", "units": [["st", 5], ["dl", 70]] },

    { "match": "^(Mjölk|Mellanmjölk|Lättmjölk|Filmjölk|Fil|Yoghurt|Yoghurtdryck|Havredryck|Sojadryck|Mandeldryck|Mjölkdryck|Kefir)( |$)", "units": [["dl", 103], ["glas", 206]] },
    { "match": "^(Juice|Apelsinjuice|Äppeljuice|Läsk|Saft|Vatten)( |$)(?!.*konc)", "units": [["dl", 100], ["glas", 200]] },
    { "match": "^(Kaffe bryggt|Te bryggt)", "units": [["kopp", 150], ["dl", 100]] },
    { "match": "^Öl ", "units": [["st", 330], ["dl", 100]] },
    { "match": "^Vin (rött|vitt)", "units": [["glas", 150], ["dl", 100]] },
    { "match": "^(Vispgrädde|Matlagningsgrädde|Gräddfil|Crème fraiche|Creme fraiche)", "units": [["msk", 15], ["dl", 100]] },
    { "match": "^Kvarg", "units": [["dl", 110], ["msk", 17]] },

    { "match": "^Havregryn", "units": [["dl", 35], ["msk", 6]] },
    { "match": "^Havregrynsgröt|^Gröt", "units": [["portion", 250], ["dl", 100]] },
    { "match": "^Frukostflingor", "units": [["dl", 40], ["portion", 50]] },
    { "match": "^Ris .*okokt", "units": [["dl", 85]] },
    { "match": "^Ris .*kokt", "units": [["dl", 75], ["portion", 150]] },
    { "match": "^Pasta .*okokt", "units": [["dl", 40]] },
    { "match": "^Pasta .*kokt", "units": [["dl", 50], ["portion", 150]] },
    { "match": "^Vetemjöl", "units": [["dl", 60], ["msk", 9], ["tsk", 3]] },
    { "match": "^Socker$|^Strösocker", "units": [["dl", 85], ["msk", 13], ["tsk", 4]] },
    { "match": "^Honung", "units": [["msk", 21], ["tsk", 7]] },
    { "match": "^Linser torkade", "units": [["dl", 85]] },
    { "match": "^Kikärtor (konserv|torkade kokta)", "units": [["dl", 65]] },

    { "match": "^(Smör|Matfettsblandning|Bordsmargarin|Margarin)( |$)", "units": [["smörgås", 5], ["tsk", 5], ["msk", 14]] },
    { "match": "^(Rapsolja|Olivolja|Solrosolja|Olja)", "units": [["msk", 14], ["tsk", 5], ["dl", 92]] },
    { "match": "^Jordnötssmör", "units": [["msk", 16], ["tsk", 5]] },
    { "match": "^Ost hårdost|^Ost .*hushållsost|^Ost grevé|^Ost präst", "units": [["skiva", 10]] },
    { "match": "^Mjukost", "units": [["smörgås", 10]] },
    { "match": "^Leverpastej", "units": [["smörgås", 15]] },

    { "match": "^Bröd (?!.*(scones|croissant|chapati|pita|tortilla|Hönökaka|tekaka|tunnbröd|fralla|baguette|ciabatta|giffel|rallarhalvor))", "units": [["skiva", 40]] },
    { "match": "^Hårt bröd", "units": [["st", 15]] },
    { "match": "^Pannkaka tunn", "units": [["st", 50]] },
    { "match": "^Köttbullar", "units": [["st", 15]] },
    { "match": "^Korv falukorv", "units": [["skiva", 30]] },
    { "match": "^Kyckling bröstfilé", "units": [["st", 125]] },
    { "match": "^Hamburgare nöt", "units": [["st", 90]] }
  ]
}
